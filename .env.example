# Google Earth Engine
GEE_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com
GEE_KEY_FILE=gee_key.json

# NASA FIRMS
FIRMS_MAP_KEY=your_firms_map_key

# MOSDAC (INSAT-3D) — optional; AOD now sourced from MODIS MAIAC via GEE
MOSDAC_TOKEN=your_mosdac_bearer_token

# OpenAQ v3 (real CPCB ground data — last 90 days). Get a free key at https://explore.openaq.org/
OPENAQ_API_KEY=your_openaq_api_key

# PostgreSQL + PostGIS
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=isro_aqi
POSTGRES_USER=isro
POSTGRES_PASSWORD=isropassword
DATABASE_URL=postgresql://isro:isropassword@localhost:5432/isro_aqi

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=isro-data

# Data paths
ZARR_AQI_PATH=data/processed/aqi_cube.zarr
ZARR_HCHO_PATH=data/processed/hcho_cube.zarr
MODELS_PATH=data/serving/models

# Backend
API_KEY=dev_api_key_change_in_prod
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
